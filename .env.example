# OCR engine: paddleocr
OCR_ENGINE=paddleocr

# Maximum file upload size in bytes (default 20MB)
MAX_FILE_SIZE=20971520

# Logging level
LOG_LEVEL=INFO

# LLM: API key is required for LLM-based extraction
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
LLM_MAX_INPUT_CHARS=8000
LLM_MAX_TOKENS=1024

# Caching
CACHE_ENABLED=false

# GPU acceleration
GPU_ENABLED=false